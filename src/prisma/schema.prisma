// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Fabric {
  id                    String          @id @default(cuid())
  reference             String          @unique
  name                  String
  color                 String
  unit                  UnitType
  width                 Float?          @default(0)
  stockMeters           Float?          @default(0)
  stockUnits            Int?            @default(0)
  alertThresholdMeters  Float?          
  alertThresholdUnits   Int?
  pricePerMeter         Float           @default(0)
  pricePerUnit          Float           @default(0)
  isArchived            Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  stockMovements        StockMovement[]
  quotes                Quote[]
  quoteItems            QuoteItem[]
}


model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique @default(cuid())
  status      QuoteStatus @default(DRAFT)
  totalPrice  Float       @default(0)
  quantity    Float       @default(0) // On l'ajoute pour corriger ton erreur d'action
  createdAt   DateTime    @default(now())
  validatedAt DateTime?
  isTTC       Boolean     @default(false)
  items       QuoteItem[]
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  fabricId    String
  fabric      Fabric      @relation(fields: [fabricId], references: [id])
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
}

model Client {
  id          String   @id @default(cuid())
  name        String   // Nom de la personne ou contact principal
  company     String?  // Optionnel (B2B)
  email       String?  // Optionnel
  phone       String?  // Optionnel
  
  // 🆕 Nouveaux champs pour l'adresse de facturation
  address     String?  // Rue / Numéro
  zipCode     String?  // Code Postal
  city        String?  // Ville
  country     String?  @default("France") // Pays (par défaut France)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      Quote[]  
}

model StockMovement {
  id             String       @id @default(cuid())
  fabricId       String
  type           MovementType // ENTRY ou EXIT
  quantityMeters Float?       
  quantityUnits  Int?
  reason         String
  
  // 🆕 AJOUT : Le prix d'achat spécifique pour ce lot / mouvement d'entrée
  purchasePriceHT Float       @default(0) 

  createdAt      DateTime     @default(now())
  fabric         Fabric       @relation(fields: [fabricId], references: [id])
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  fabricId        String
  quantityMeters  Float?   // Changé Decimal -> Float
  quantityUnits   Int?
  prodTimeMinutes Int
  costPerMinute   Float    // Changé Decimal -> Float
  sellingPrice    Float    // Changé Decimal -> Float
  statusProduction String    @default("A_COUPER")
  createdAt        DateTime @default(now())    // Entrée en coupe
  startedCoutureAt DateTime?                   // Passage en couture (= Fin de la coupe)
  finishedAt       DateTime?                   // Passage à Prêt (= Fin de la couture)
  isChute          Boolean   @default(false)     // Case à cocher "Chute"
  discountPercent  Float     @default(0.0)       // Pour les promos
  quote  Quote  @relation(fields: [quoteId], references: [id])
  fabric Fabric @relation(fields: [fabricId], references: [id])
}

// ② STOCK PRODUITS FINIS (Confection Maison)
model FinishedProduct {
  id              String   @id @default(cuid())
  reference       String   @unique
  name            String
  family          String   // FITTED, ENVELOPE, FLAT, etc.
  dimensions      String   // Ex: "140x190x30" ou "220x240"
  stockQuantity   Int      @default(0)
  alertThreshold  Int      @default(5)     // 🚨 Seuil d'alerte configuré par Nicole
  sellingPriceHT  Float    // Prix de vente habituel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lots FinishedProductLot[]
}

model FinishedProductLot {
  id                 String          @id @default(cuid())
  finishedProductId  String
  quantityManufactured Int           // Combien Nicole en a cousu ce jour-là
  quantityLeft       Int             // Ce qu'il reste à vendre de cette fournée
  sellingPriceHT     Float           // 📈 Prix de vente fixé pour CETTE production
  createdAt          DateTime        @default(now())

  finishedProduct    FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
}

model SaleLog {
  id              String   @id @default(cuid())
  referenceItem   String
  name            String
  type            String
  quantitySold    Int
  totalPriceHT    Float
  paymentMethod   String
  isTTC           Boolean  @default(false) // 🆕 Vente particulier (TTC)
  totalPriceTTC   Float    @default(0)     // 🆕 Montant final payé avec TVA
  ticketId      String?
  createdAt       DateTime @default(now())
}

// Modification du modèle ③ pour refléter les lots
model Merchandise {
  id              String           @id @default(cuid())
  reference       String           @unique
  name            String
  category        String
  alertThreshold  Int              @default(3)
  sellingPriceHT  Float            // Le prix de revente en boutique (unique)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // 🆕 Liaison vers les lots d'achats différents
  lots            MerchandiseLot[]
}

model MerchandiseLot {
  id              String      @id @default(cuid())
  merchandiseId   String
  quantityBought  Int
  quantityLeft    Int
  purchasePriceHT Float       // 💰 Prix auquel tu l'as acheté
  sellingPriceHT  Float       @default(0) // 📈 Prix auquel tu as décidé de le vendre LE JOUR J
  createdAt       DateTime    @default(now())

  merchandise     Merchandise @relation(fields: [merchandiseId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())

  quotes Quote[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UnitType {
  METER
  UNIT
}

enum MovementType {
  ENTRY
  EXIT
}

enum QuoteStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model Range {
  id            String   @id @default(cuid())
  name          String   // ex: "Monaco", "Antibes"
  isBicolor     Boolean  @default(false)
  pricePremium  Float    @default(0) // Supplément de prix
}

model ProductType {
  id            String   @id @default(cuid())
  name          String   // ex: "Housse de couette"
  family        String   // "FLAT", "FITTED", "ENVELOPE"
  baseLaborTime Int      // Temps en minutes
}

model AtelierSettings {
  id              String   @id @default("global") // Toujours "global" pour n'avoir qu'une ligne
  marginRate      Float    @default(2.5)          // Multiplicateur de marge (ex: x2.5)
  laborCostPerMin Float    @default(0.35)         // Coût de la minute de main-d'œuvre (ex: 0.35 €)
  updatedAt       DateTime @updatedAt
}