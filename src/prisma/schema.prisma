// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// 🆕 NOUVELLES ÉNUMÉRATIONS
enum ItemLocation {
  ATELIER
  BOUTIQUE
}

enum ReturnReason {
  CLIENT_ERROR       // Erreur client ou changement d'avis
  NG_ERROR           // Défaut ou erreur de l'atelier
  DELIVERY_FAIL      // Retour colis involontaire
}

enum UnitType {
  METER
  UNIT
}

enum MovementType {
  ENTRY
  EXIT
}

enum QuoteStatus {
  DRAFT
  VALIDATED
  DELIVERED     // 🆕 Colis envoyé / Produit remis
  ARCHIVED
  CANCELLED
}

enum UserRole {
  ADMIN
  CONFECTION
  BOUTIQUE
}

enum AppFeature {
  DASHBOARD
  STOCK_BOUTIQUE
  STOCK_ATELIER
  PRODUCTION
  QUOTES
  COMMANDES
  FOURNISSEURS
  CLIENTS
  SETTINGS
}

model RolePermission {
  id        String     @id @default(cuid())
  role      UserRole   // USER, ADMIN, etc.
  feature   AppFeature // La page ou fonctionnalité cible
  canAccess Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([role, feature]) // Une seule règle par couple Rôle/Feature
}

// ==========================================
// 1. TISSUS ET ACCESSOIRES
// ==========================================

model Fabric {
  id                    String          @id @default(cuid())
  reference             String          @unique
  name                  String
  color                 String
  unit                  UnitType
  width                 Float?          @default(0)
  stockMeters           Float?          @default(0) // Gardé comme cache global
  stockUnits            Int?            @default(0) // Gardé comme cache global
  alertThresholdMeters  Float?          
  alertThresholdUnits   Int?
  pricePerMeter         Float           @default(0)
  pricePerUnit          Float           @default(0)
  isArchived            Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  stockMovements        StockMovement[]
  quotes                Quote[]
  lots                  FabricLot[]     // 🆕 Lots de tissus (valeur absolue)
  
  // 🟢 NOUVEAU : Double liaison avec QuoteItem pour Face A et Face B
  quoteItemsA           QuoteItem[] @relation("FabricA")
  quoteItemsB           QuoteItem[] @relation("FabricB")

  supplierRef  String?
}

model FabricLot {
  id               String       @id @default(cuid())
  fabricId         String
  quantityBought   Float        // Quantité initiale du rouleau
  quantityLeft     Float        // Quantité restante
  purchasePriceHT  Float        // Prix d'achat réel de ce lot
  location         ItemLocation @default(ATELIER) // 🆕 Localisation Atelier vs Boutique
  createdAt        DateTime     @default(now())

  fabric           Fabric       @relation(fields: [fabricId], references: [id], onDelete: Cascade)
}

model Accessory {
  id               String         @id @default(cuid())
  reference        String         @unique
  name             String
  category         String         // ex: "Fermeture Éclair", "Bobine de fil"
  stockQuantity    Float          @default(0)
  unit             UnitType       @default(UNIT)
  alertThreshold   Float          @default(10)
  pricePerUnit     Float          @default(0)
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lots             AccessoryLot[]
  quoteItems       QuoteItem[]
}

model AccessoryLot {
  id               String       @id @default(cuid())
  accessoryId      String
  quantityBought   Float
  quantityLeft     Float
  purchasePriceHT  Float
  location         ItemLocation @default(ATELIER)
  createdAt        DateTime     @default(now())

  accessory        Accessory    @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  supplierRef  String?
}


model StockMovement {
  id               String       @id @default(cuid())
  fabricId         String
  type             MovementType 
  quantityMeters   Float?       
  quantityUnits    Int?
  reason           String
  purchasePriceHT  Float        @default(0) 

  createdAt        DateTime     @default(now())
  fabric           Fabric       @relation(fields: [fabricId], references: [id])
}

// ==========================================
// 2. CRM & DEVIS (COMMANDES)
// ==========================================

model Client {
  id        String       @id @default(cuid())
  name      String   
  company   String?  
  email     String?  
  phone     String?  
  address   String?  
  zipCode   String?  
  city      String?  
  country   String?  @default("France") 
  source    ClientSource @default(DIRECT_ATELIER)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quotes    Quote[]  
}

model Partner {
  id        String   @id @default(cuid())
  name      String   
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes    Quote[]  
}

model Quote {
  id            String        @id @default(cuid())
  reference     String        @unique @default(cuid())
  status        QuoteStatus   @default(DRAFT)
  totalPrice    Float         @default(0)
  quantity      Float         @default(0) 
  createdAt     DateTime      @default(now())
  validatedAt   DateTime?
  dueDate       DateTime?     
  returnReason  ReturnReason? 
  taxRate       Float         @default(20.0) 
  isTaxExempt   Boolean       @default(false) 
  isTTC         Boolean       @default(false)
  paymentMethod String?       
  products      Json?
  
  // 🟢 NOUVEAU : Ajout de la marque (NG, VOSGIA, ou NONE)
  brand         String        @default("NG")
  
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  fabricId      String
  fabric        Fabric        @relation(fields: [fabricId], references: [id])
  
  // 🟢 MODIFICATION : Le client devient totalement optionnel (ajout des '?' )
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  
  items         QuoteItem[]
  isPaid        Boolean       @default(false)

  partnerId     String?
  partner       Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
}

enum ClientSource {
  WEB_VOSGIA
  DIRECT_ATELIER
  PARTENAIRE_B2B
}

enum PaymentStatus {
  NON_PAYE
  ACOMPTE_VERSE
  PAYE
}

model QuoteItem {
  id               String    @id @default(cuid())
  quoteId          String
  accessoryId      String?   
  
  customName       String?   
  customMargin     String?   
  customPriceHT    Float?    

  quantityUnits    Int?
  prodTimeMinutes  Int
  costPerMinute    Float     
  sellingPrice     Float     
  statusProduction String    @default("A_COUPER")
  createdAt        DateTime  @default(now())    
  startedCoutureAt DateTime?                    
  finishedAt       DateTime?                    
  isChute          Boolean   @default(false)      
  discountPercent  Float     @default(0.0)        

  coteA            Float?    
  coteB            Float?    
  coteC            Float?    
  coteD            Float?    
  coteE            Float?    
  bonnet           Int       @default(0)
  blueprintUrl     String?   

  // 🟢 NOUVEAU : Tissu Principal (Face A)
  fabricId         String?   
  fabric           Fabric?   @relation("FabricA", fields: [fabricId], references: [id]) 
  quantityMeters   Float?    
  supplies  Json?   // 🟢 NOUVEAU : Stocke les id et métrages de la mercerie
  
  // 🟢 NOUVEAU : Tissu Secondaire (Face B)
  fabricBId        String?
  fabricB          Fabric?   @relation("FabricB", fields: [fabricBId], references: [id])
  quantityMetersB  Float?

  quote            Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  accessory        Accessory? @relation(fields: [accessoryId], references: [id]) 
}

// ==========================================
// 3. BOUTIQUE (PRODUITS FINIS ET MARCHANDISES)
// ==========================================

model FinishedProduct {
  id              String   @id @default(cuid())
  reference       String   @unique
  name            String
  family          String   
  dimensions      String   
  stockQuantity   Int      @default(0)
  alertThreshold  Int      @default(5)     
  sellingPriceHT  Float    
  createdAt       DateTime @default(now())
  location        ItemLocation    @default(BOUTIQUE)
  updatedAt       DateTime @updatedAt

  lots FinishedProductLot[]
}

model FinishedProductLot {
  id                   String          @id @default(cuid())
  finishedProductId    String
  quantityManufactured Int              
  quantityLeft         Int              
  sellingPriceHT       Float
  location             ItemLocation @default(BOUTIQUE)            
  createdAt            DateTime        @default(now())

  finishedProduct      FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
}

model Merchandise {
  id              String   @id @default(cuid())
  reference       String   @unique
  name            String
  category        String
  alertThreshold  Int      @default(3)
  sellingPriceHT  Float    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  lots            MerchandiseLot[]
}

model MerchandiseLot {
  id               String       @id @default(cuid())
  merchandiseId    String
  quantityBought   Int
  quantityLeft     Int
  purchasePriceHT  Float        
  sellingPriceHT   Float        @default(0)
  location         ItemLocation @default(BOUTIQUE)
  createdAt        DateTime     @default(now())

  merchandise      Merchandise  @relation(fields: [merchandiseId], references: [id], onDelete: Cascade)
}

model SaleLog {
  id               String   @id @default(cuid())
  referenceItem    String
  name             String
  type             String
  quantitySold     Int
  unitPriceHT      Float?   @default(0) 
  discountPercent  Float?   @default(0) 
  totalPriceHT     Float
  paymentMethod    String
  taxRate          Float    @default(20.0)  
  isTaxExempt      Boolean  @default(false) 
  isTTC            Boolean  @default(false) 
  totalPriceTTC    Float    @default(0)     
  ticketId         String?
  createdAt        DateTime @default(now())
}

// ==========================================
// 4. SYSTÈME ET PARAMÈTRES
// ==========================================

model Range {
  id              String   @id @default(cuid())
  name            String   
  isBicolor       Boolean  @default(false)
  pricePremium    Float    @default(0) 
}

model ProductType {
  id              String   @id @default(cuid())
  name            String   
  family          String   
  baseLaborTime   Int      
}

model AtelierSettings {
  id              String @id @default("global")
  marginRate      Float
  laborCostPerMin Float
  auditQuota      Int    @default(10) // 10 pièces
  auditPeriod     Int    @default(12) // par 12 mois
}

// AUTHENTIFICATION NEXT-AUTH
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CONFECTION)
  createdAt     DateTime  @default(now())
  quotes        Quote[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model SupplierCatalogItem {
  id              String   @id @default(uuid())
  supplierName    String   
  reference       String
  color           String?  
  ngColor         String?  
  designation     String?
  purchasePriceHT Float    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([supplierName, reference])
}